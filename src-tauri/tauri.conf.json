{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Migration Helper",
  "version": "0.2.0",
  "identifier": "org.pcmigrationhelper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PC Migration Helper",
        "width": 1420,
        "height": 920,
        "minWidth": 940,
        "minHeight": 640,
        "theme": "Dark",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
